# Bundles and stylesheets are versioned but NOT content-hashed, so they must
# still revalidate on every request — `no-cache` allows an empty 304 response
# instead of re-sending the full body (dist/admin.min.js is ~600 KB).
# NOTE: worker.js sets these same header values in its own copy of this
# table, but that copy is DEAD CODE for every path here — Cloudflare Workers
# Assets serves any request matching a real file directly, without invoking
# the Worker script at all, unless the path is listed in wrangler.jsonc's
# `run_worker_first` (here: only "/" and "/index.html"). This file is what
# actually governs every real static file's response headers in production;
# worker.js's copy only matters for the security headers below on paths the
# Worker script itself handles. Kept in sync anyway so reading either file
# tells the truth about intended behavior.
#
# Pragma/Expires are NOT redeclared per-path below. This file previously tried
# to blank them out here (`Pragma:` / `Expires:` with no value) to stop the
# `/*` block's `Pragma: no-cache` / `Expires: 0` from being inherited — but
# Cloudflare's _headers parser rejects an empty value outright as invalid
# syntax, and it silently failed `wrangler deploy` on every push for a full
# day (2026-08-02 21:52 -> 2026-08-03 20:35, 7 straight failed deploys) while
# the merge-to-main half of the workflow kept succeeding, so nothing looked
# wrong from the git history alone. Cache-Control is what every modern
# browser and Cloudflare's own edge actually honor when both are present, so
# the inherited Pragma/Expires here are inert — safe to leave inherited
# rather than risk the same mistake again.
/dist/*
  Cache-Control: no-cache

/css/*
  Cache-Control: no-cache

# Content-stable media can be cached hard.
/img/*
  Cache-Control: public, max-age=31536000, immutable

# /images/logo/ holds brand assets (favicons, wordmark, and each app's
# launcher/maskable icons under logo/apps/*) that get replaced in place under
# the same filename on a rebrand — the same "not content-hashed" hazard as
# the bundles above. It's listed as its OWN rule, and the other /images/
# subdirectories are listed individually below rather than as one blanket
# /images/* immutable rule, because Cloudflare's _headers matching is
# ADDITIVE, not override-by-declaration-order: when two blocks both match a
# path, both Cache-Control values are sent and combined into one
# self-contradictory comma-joined header, not "last block wins". A blanket
# /images/* immutable rule plus this /images/logo/* no-cache rule produced
# exactly that — "no-store, no-cache, must-revalidate, public,
# max-age=31536000, immutable, no-cache" on every logo/apps/*/*.png response,
# live in production on 2026-09-11 — so the icon-cache fix never actually
# took effect. Keeping each subdirectory's rule non-overlapping with this one
# is what makes it actually win.
/images/logo/*
  Cache-Control: no-cache

/images/icons/*
  Cache-Control: public, max-age=31536000, immutable

/images/illustrations/*
  Cache-Control: public, max-age=31536000, immutable

/images/staff/*
  Cache-Control: public, max-age=31536000, immutable
