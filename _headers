/*
  Cache-Control: no-store, no-cache, must-revalidate
  Pragma: no-cache
  Expires: 0
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=()
  Content-Security-Policy: default-src 'self'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://static.cloudflareinsights.com https://staxjs.staxpayments.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://cdn.jsdelivr.net https://cloudflareinsights.com https://apiprod.fattlabs.com https://fattqueryprod.fattlabs.com https://transactions.fattlabs.com; img-src 'self' data:; frame-src https://maps.google.com https://www.google.com https://test.authorize.net https://accept.authorize.net https://staxjs.staxpayments.com https://omni.fattmerchant.com; font-src 'self' data: https://fonts.gstatic.com

# Bundles and stylesheets are versioned but NOT content-hashed, so they must
# still revalidate on every request — `no-cache` allows an empty 304 response
# instead of re-sending the full body (dist/admin.min.js is ~600 KB).
# NOTE: worker.js sets these headers too and takes precedence in the Workers
# Assets deploy; both are kept in sync so the behavior is the same either way.
#
# Pragma/Expires are NOT redeclared per-path below. This file previously tried
# to blank them out here (`Pragma:` / `Expires:` with no value) to stop the
# `/*` block's `Pragma: no-cache` / `Expires: 0` from being inherited — but
# Cloudflare's _headers parser rejects an empty value outright as invalid
# syntax, and it silently failed `wrangler deploy` on every push for a full
# day (2026-08-02 21:52 -> 2026-08-03 20:35, 7 straight failed deploys) while
# the merge-to-main half of the workflow kept succeeding, so nothing looked
# wrong from the git history alone. Cache-Control is what every modern
# browser and Cloudflare's own edge actually honor when both are present, so
# the inherited Pragma/Expires here are inert — safe to leave inherited
# rather than risk the same mistake again.
/dist/*
  Cache-Control: no-cache

/css/*
  Cache-Control: no-cache

# Content-stable media can be cached hard.
/img/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable
